"""Boyutlandirma adaylari + XFOIL 2B polarlari -> dogrusal olmayan LLT.

Kurulum: python -m pip install numpy matplotlib
Ornek: python aday_lifting_line.py --adaylar kanat_kuyruk_adaylari.csv --polar-dir airfoils_polar
Detaylar: KULLANIM.md. Acilar dosyalarda derece, LLT denkleminde radyandir.
"""
from __future__ import annotations
import argparse
import csv
import importlib.util
import json
import re
from pathlib import Path
import numpy as np


def polar_oku(path):
    """XFOIL baslikli veya alpha,CL baslikli CSV/whitespace polar okur."""
    text = Path(path).read_text(encoding="utf-8-sig", errors="replace")
    rows, cols = [], None
    for line in text.splitlines():
        tokens = re.split(r"[,;\s]+", line.strip())
        lower = [t.lower() for t in tokens]
        if "alpha" in lower and "cl" in lower:
            cols = (lower.index("alpha"), lower.index("cl"))
            continue
        if cols is None:
            continue
        try:
            a, cl = [float(tokens[i].replace("D", "E")) for i in cols]
        except (ValueError, IndexError):
            continue
        if np.isfinite(a) and np.isfinite(cl):
            rows.append((a, cl))
    if len(rows) < 3:
        raise ValueError(f"{path}: alpha/CL basligi altinda en az 3 sayisal satir gerekli.")
    unique = {}
    for a, cl in rows:
        if a in unique and abs(unique[a] - cl) > 1e-5:
            raise ValueError(f"{path}: ayni alpha icin farkli CL; polar bloklarini ayirin.")
        unique[a] = cl
    data = np.array(sorted(unique.items()))
    if len(data) < 3:
        raise ValueError(f"{path}: en az 3 farkli alpha gerekli.")
    match = re.search(r"\bRe\s*=\s*([\d.]+)\s*[eE]\s*([+-]?\d+)", text)
    reynolds = float(match[1]) * 10 ** int(match[2]) if match else None
    return data[:, 0], data[:, 1], reynolds


def interp_with_slope(x, xp, yp):
    # Uc uzatma yalnizca Newton aramasi icin; disaridaki nihai cozum reddedilir.
    i = np.clip(np.searchsorted(xp, x, side="right") - 1, 0, len(xp) - 2)
    slope = (yp[i + 1] - yp[i]) / (xp[i + 1] - xp[i])
    return yp[i] + slope * (x - xp[i]), slope


def lifting_line(b, area, chord, polar_alpha, polar_cl, alphas, modes=24):
    """Simetrik, burulmasiz, dikdortgen izole kanat; tek sayili Fourier modlari.

    Gamma=2*b*V*sum(A_n*sin(n*theta)); cl=4*b/c*sum(A_n*sin(n*theta))
    alpha_i=sum(n*A_n*sin(n*theta)/sin(theta)); CL=pi*AR*A_1.
    Yerel cl(alpha-alpha_i) dogrudan polar interpolasyonundan gelir.
    """
    if not all(np.isfinite(v) and v > 0 for v in (b, area, chord)):
        raise ValueError("Geometri sonlu ve pozitif olmali.")
    if not np.isclose(b * chord, area, rtol=1e-4):
        raise ValueError("Bu surum yalnizca dikdortgen kanat icindir: S=b*c olmali.")
    if modes < 4:
        raise ValueError("En az 4 Fourier modu gerekli.")
    theta = np.arange(1, modes + 1) * np.pi / (2 * modes)
    n = np.arange(1, 2 * modes, 2)
    sine = np.sin(theta[:, None] * n)
    lift_matrix = 4 * b / chord * sine
    downwash = sine * n / np.sin(theta[:, None])
    xp = np.deg2rad(polar_alpha)
    coeff = np.zeros(modes)
    results = []
    # Sifir kaldirmaya yakin noktadan basla; iki yonde continuation.
    anchor = polar_alpha[np.argmin(np.abs(polar_cl))]
    pivot = int(np.argmin(np.abs(alphas - anchor)))
    branches = [range(pivot, len(alphas)), range(pivot - 1, -1, -1)]
    initial = coeff.copy()
    for branch_index, branch in enumerate(branches):
        coeff = initial.copy()
        for index in branch:
            alpha = float(alphas[index])
            def residual(a):
                effective = np.deg2rad(alpha) - downwash @ a
                sectional, slope = interp_with_slope(effective, xp, polar_cl)
                return lift_matrix @ a - sectional, slope, effective
            trial = coeff.copy()
            for iteration in range(100):
                r, slope, effective = residual(trial)
                if np.max(np.abs(r)) < 1e-8:
                    break
                jac = lift_matrix + slope[:, None] * downwash
                step = np.linalg.lstsq(jac, -r, rcond=None)[0]
                norm = np.linalg.norm(r)
                for factor in 0.5 ** np.arange(16):
                    proposed = trial + factor * step
                    if np.linalg.norm(residual(proposed)[0]) < norm:
                        trial = proposed
                        break
                else:
                    break
            r, _, effective = residual(trial)
            error = float(np.max(np.abs(r)))
            inside = bool(np.all(effective >= xp[0] - 1e-9) and np.all(effective <= xp[-1] + 1e-9))
            status = "ok" if error < 1e-6 and inside else ("polar_araligi_disi" if not inside else "yakinsamadi")
            valid = status == "ok"
            if valid:
                coeff = trial.copy()
            if branch_index == 0 and index == pivot:
                initial = coeff.copy()
            results.append(dict(alpha_deg=alpha, CL_3D=float(np.pi * b*b/area * trial[0]) if valid else np.nan,
                                CDi=float(np.pi * b*b/area * np.sum(n * trial**2)) if valid else np.nan,
                                alpha_eff_min_deg=float(np.rad2deg(effective.min())),
                                alpha_eff_max_deg=float(np.rad2deg(effective.max())),
                                residual=error, status=status))
    return sorted(results, key=lambda r: r["alpha_deg"])


def csv_yaz(path, rows):
    with Path(path).open("w", newline="", encoding="utf-8-sig") as f:
        writer = csv.DictWriter(f, fieldnames=list(rows[0]))
        writer.writeheader()
        writer.writerows(rows)


def main():
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    p = argparse.ArgumentParser(description=__doc__)
    source = p.add_mutually_exclusive_group(required=True)
    source.add_argument("--adaylar", type=Path, help="Boyutlandirma CSV ciktisi")
    source.add_argument("--boyutlandirma", type=Path, help="kanat_kuyruk_boyutlandirma.py yolu")
    p.add_argument("--kutle", type=float)
    p.add_argument("--govde", type=float)
    p.add_argument("--polar-dir", type=Path, required=True)
    p.add_argument("--output", type=Path, default=Path("llt_sonuclar"))
    p.add_argument("--alpha-min", type=float, default=-5)
    p.add_argument("--alpha-max", type=float, default=15)
    p.add_argument("--alpha-step", type=float, default=0.5)
    p.add_argument("--modes", type=int, default=24)
    p.add_argument("--surface", choices=["wing", "ht"], default="wing")
    args = p.parse_args()
    if not all(np.isfinite(x) for x in (args.alpha_min, args.alpha_max, args.alpha_step)) or args.alpha_step <= 0 or args.alpha_max < args.alpha_min or args.modes < 4:
        p.error("Alpha araligi/adimi veya mod sayisi gecersiz.")
    if args.adaylar:
        with args.adaylar.open(encoding="utf-8-sig", newline="") as f:
            candidates = list(csv.DictReader(f))
    else:
        if args.kutle is None or args.govde is None or not all(np.isfinite(x) and x > 0 for x in (args.kutle, args.govde)):
            p.error("Modulden aday uretmek icin pozitif --kutle ve --govde gerekli.")
        spec = importlib.util.spec_from_file_location("boyutlandirma", args.boyutlandirma)
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        candidates = module.tum_adaylari_uret(args.kutle, args.govde, ws_birimi="kg/m2")
    if not candidates:
        p.error("Aday bulunamadi.")
    polars, errors = {}, []
    for path in sorted(args.polar_dir.rglob("*")):
        if path.is_file() and path.suffix.lower() in {".txt", ".dat", ".csv", ".pol"}:
            try:
                polars[path.relative_to(args.polar_dir).as_posix()] = polar_oku(path)
            except ValueError as e:
                errors.append(str(e))
    if not polars:
        p.error("Okunabilir polar bulunamadi. " + "\n".join(errors))
    args.output.mkdir(parents=True, exist_ok=True)
    alphas = np.arange(args.alpha_min, args.alpha_max + args.alpha_step * 1e-6, args.alpha_step)
    summary, cache = [], {}
    keys = ("b_w_m", "S_w_m2", "c_root_w_m") if args.surface == "wing" else ("b_HT_m", "S_HT_m2", "c_root_HT_m")
    for i, candidate in enumerate(candidates, 1):
        b, area, chord = [float(candidate[k]) for k in keys]
        if args.surface == "wing" and not np.isclose(float(candidate.get("c_tip_w_m", chord)), chord):
            raise ValueError(f"Aday {i}: dikdortgen olmayan kanat desteklenmiyor.")
        assigned = candidate.get("polar_file", "").strip().replace("\\", "/")
        selected = [assigned] if assigned else list(polars)
        for name in selected:
            if name not in polars:
                raise ValueError(f"Aday {i}: polar_file bulunamadi: {name}")
        folder = args.output / f"aday_{i:03d}_{args.surface}"
        folder.mkdir(exist_ok=True)
        for j, name in enumerate(selected, 1):
            pa, pc, reynolds = polars[name]
            key = (b, area, chord, name)
            if key not in cache:
                cache[key] = lifting_line(b, area, chord, pa, pc, alphas, args.modes)
            rows = cache[key]
            stem = f"{j:03d}_" + re.sub(r"[^\w.-]+", "_", Path(name).stem)
            csv_yaz(folder / f"{stem}.csv", rows)
            fig, ax = plt.subplots(figsize=(8, 5))
            ax.plot(pa, pc, "--", color="gray", label="2B profil cl (polar)")
            ax.plot(alphas, [r["CL_3D"] for r in rows], "-o", ms=2, label="3B CL (nonlinear LLT)")
            bad = sum(r["status"] != "ok" for r in rows)
            ax.set(xlabel="Hucum acisi alpha [derece]", ylabel="Kaldirma katsayisi",
                   title=f"Aday {i} | {args.surface} | {name}\nb={b:.3f} m, AR={b*b/area:.2f}, Re={reynolds or 'bilinmiyor'} | gecersiz: {bad}")
            ax.grid(alpha=0.3)
            ax.legend()
            fig.tight_layout()
            fig.savefig(folder / f"{stem}.png", dpi=160)
            plt.close(fig)
            summary.append(dict(aday=i, surface=args.surface, polar_file=name, polar_Re=reynolds,
                                b_m=b, S_m2=area, c_m=chord, AR=b*b/area,
                                valid_points=len(rows)-bad, invalid_points=bad,
                                csv=str((folder / f"{stem}.csv").relative_to(args.output))))
        (folder / "geometri.json").write_text(json.dumps(candidate, indent=2, ensure_ascii=False), encoding="utf-8")
        print(f"Aday {i}/{len(candidates)}: {len(selected)} polar tamamlandi.")
    csv_yaz(args.output / "ozet.csv", summary)
    (args.output / "okuma_uyarilari.txt").write_text("\n".join(errors) or "Polar okuma hatasi yok.", encoding="utf-8")
    (args.output / "calisma_ayarlari.json").write_text(json.dumps(vars(args), default=str, indent=2), encoding="utf-8")
    print(f"Tamamlandi: {args.output.resolve()}. Reynolds polar dosyasindaki sabit degerdir; ucus Reynolds'u hesaplanmadi.")


if __name__ == "__main__":
    main()
